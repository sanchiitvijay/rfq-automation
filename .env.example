# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# --- AI contradiction check (Quality Agent) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Backend ---
# SQLite file (relative paths are from the repo root); Postgres also works: postgresql+asyncpg://localhost/rfq
DATABASE_URL=sqlite+aiosqlite:///out/rfq.sqlite3
REDIS_URL=redis://localhost:6379/0
API_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
WORKER_MAX_JOBS=4

# --- Lookup ---
# SerpApi (https://serpapi.com) is tried first: Google confirms the product page + price without
# touching ferguson.com. Empty key, or quota used up -> products are read from ferguson.com directly.
SERPAPI_API_KEY=
# A fresh SerpApi search can take 20-60 s; after this many seconds the product page is read instead
SERPAPI_TIMEOUT_S=45
# After a SerpApi hit, also open the product page? missing = only if the catalog lacks the product
# (SerpApi has no spec table) | always | never
SCRAPE_AFTER_SERPAPI=missing
# ferguson.com blocks bursts: page loads per minute across ALL workers (PDF downloads count too)
FERGUSON_RATE_PER_MINUTE=12
CHROME_CDP_URL=http://127.0.0.1:9333
RFQ_OFFLINE=false
RFQ_USE_LLM=true
# Download product thumbnails and show them in the Excel's Image column
RFQ_EMBED_IMAGES=true

# --- Sending (Gmail: BOT_PASSWORD is a 16-letter App Password, not your normal password) ---
BOT_EMAIL=
BOT_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
# Optional: only allow these recipient domains, comma separated (empty = any)
ALLOWED_RECIPIENT_DOMAINS=
